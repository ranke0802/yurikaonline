{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "sample/**",
      "package.json",
      "package-lock.json",
      "LOCAL_DEV.md",
      "README.md",
      "docs/**",
      "plans/**",
      "reports/**",
      "scripts/**",
      "tests/**",
      "database*.json",
      "firebase.emulator.json",
      "playwright.config.*",
      "**/*.log",
      "**/*.map",
      "**/*.png",
      "src/js/main.old.js",
      "src/modules/**",
      "src/js/modules/**",
      "src/assets/**",
      "assets/resource/**/*.webp",
      "assets/resource/**/*.json",
      "assets/data/**",
      "assets/ui/**",
      "party-rpg-concept/**",
      "*.md",
      "**/*generation-prompts*",
      "**/*handoff*",
      "src/**/*.html",
      "art-delivery/**",
      "**/*.zip",
      "**/*.part[0-9][0-9]"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/src/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/immutable/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/version.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
}
