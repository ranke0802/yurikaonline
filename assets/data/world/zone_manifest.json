{
    "schemaVersion": 1,
    "description": "World zone registry used by WorldScene and ZoneManager. Act 1 currently flows as cabin and wind hill -> Moonwell Town -> Dark Forest -> Lantern Woods dungeon without hardcoding zone_1.",
    "defaultZoneId": "zone_1",
    "supportedZoneTypes": [
        "field",
        "town",
        "dungeon",
        "story"
    ],
    "zoneTypeDescriptions": {
        "field": "Open combat/exploration zone with normal monsters and field presence.",
        "town": "Safe social/vendor/crafting zone with little or no combat.",
        "dungeon": "Instanced or progression-gated combat zone.",
        "story": "Narrative or prologue-only scene space with controlled movement/combat."
    },
    "zones": [
        {
            "id": "zone_1",
            "type": "field",
            "name": "바람 언덕 (Starting Field)",
            "path": "assets/data/zones/zone_1.json",
            "defaultSpawnId": "default",
            "entryPolicy": {
                "requiresStoryFlag": null,
                "requiresLevel": 1
            },
            "network": {
                "presenceMode": "field",
                "baseFieldId": "zone_1"
            }
        },
        {
            "id": "town_moonwell",
            "type": "town",
            "name": "달샘 마을 (Moonwell Town)",
            "path": "assets/data/zones/town_moonwell.json",
            "defaultSpawnId": "default",
            "entryPolicy": {
                "requiresStoryFlag": null,
                "requiresLevel": 1
            },
            "network": {
                "presenceMode": "town",
                "baseFieldId": "town_moonwell"
            }
        },
        {
            "id": "field_dark_forest",
            "type": "field",
            "name": "어둠숲 (Dark Forest)",
            "path": "assets/data/zones/field_dark_forest.json",
            "defaultSpawnId": "default",
            "entryPolicy": {
                "requiresStoryFlag": null,
                "requiresLevel": 1
            },
            "network": {
                "presenceMode": "field",
                "baseFieldId": "field_dark_forest"
            }
        },
        {
            "id": "dungeon_lantern_woods",
            "type": "dungeon",
            "name": "랜턴 숲 던전 (Lantern Woods)",
            "path": "assets/data/zones/dungeon_lantern_woods.json",
            "defaultSpawnId": "default",
            "entryPolicy": {
                "requiresStoryFlag": null,
                "requiresLevel": 1
            },
            "network": {
                "presenceMode": "dungeon",
                "baseFieldId": "dungeon_lantern_woods"
            }
        }
    ]
}
