        },
        {
            "id": "c1_028_lock",
            "background": "assets/generated/backgrounds/prologue_guardian_oath.webp",
            "mood": "protective",
            "name": "나",
            "text": "나는 문을 잠갔다. 쇠는 약해도 시간을 벌 수 있다.",
            "next": "c1_029",
            "i18n": {
                "en": {
                    "name": "Me",
                    "text": "I locked the door. Iron is weak, but a promise lasts longer."
