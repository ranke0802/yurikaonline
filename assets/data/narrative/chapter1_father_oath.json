                    }
                },
                {
                    "text": "숲을 태운다.",
                    "next": "c1_028_burn",
                    "i18n": {
                        "en": {
                            "text": "Burn the forest."
                        },
                        "ja": {
                            "text": "森を焼く。"
                        }
                    }
                },
                {
                    "text": "유리카를 부른다.",
                    "next": "c1_028_name",
                    "i18n": {
                        "en": {
                            "text": "Call the child's name."
                        },
                        "ja": {
                            "text": "子どもの名を呼ぶ。"
