        },
        {
            "id": "c1_024",
            "background": "assets/generated/backgrounds/prologue_guardian_oath.webp",
            "mood": "shaken",
            "name": "나",
            "text": "가르친 적 없는 결계가 문틈을 막고 있었다. 내 방어식보다 단단했고, 구조는 낯설었다.",
            "next": "c1_025",
            "i18n": {
                "en": {
                    "name": "Me",
                    "text": "A barrier I had never taught her sealed the gap in the door. It was clearer, older, and strangely sadder than my defensive formula."
                },
                "ja": {
                    "name": "私",
                    "text": "教えたことのない結界が扉の隙間を塞いでいた。私の防御式より澄んでいて、古く、妙に悲しい形だった。"
                }
            }
        },
        {
            "id": "c1_025",
            "portrait": "assets/generated/characters/yurika_portrait_frightened.webp",
