                    }
                }
            ],
            "i18n": {
                "en": {
                    "name": "Me",
                    "text": "My wife's final breath touched my ear. Protect her. That one phrase still has not let go of my hand."
                },
                "ja": {
                    "name": "私",
                    "text": "妻の最後の息が耳元に触れた。守って。その一言が、今も私の手を離さない。"
                }
